    "energies = []\n",
    "for T in range(7, 60):\n",
    "    model = IsingModel(6, 6, T=T)\n",
    "    ham = []\n",
    "    for dT in range(1, 60):\n",
    "        beta = 1.0 / (1.38 * 10**(-23) * (model.T+(dT/10)))\n",
    "        model.swendsen_wang_step(model.spins, beta)\n",
    "        ham.append((model.calc_hamilt()))\n",
    "        beta = 1.0 / (1.38 * 10**(-23) * (model.T-(dT/10)))\n",
    "        model.swendsen_wang_step(model.spins, beta)\n",
    "        ham.append((model.calc_hamilt()))\n",
    "    avg_energy = np.mean(ham)\n",
    "    energies.append(avg_energy)\n",
    "\n",
    "plt.scatter(range(7, 60), energies)\n",
    "plt.xlabel('Temperature (K)')\n",
    "plt.ylabel('Average Energy')\n",
    "plt.title('Average Energy vs Temperature for 2D Ising Model (6x6)')"
