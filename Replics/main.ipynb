    "    \n",
    "    def __len__(self):\n",
    "        return len(self.y)\n",
    "    \n",
    "    def __getitem__(self, i):\n",
    "        x = self.x[i]\n",
    "        if self.augment:\n",
    "            a = random.random() * 2 * math.pi\n",
    "            c, s = math.cos(a), math.sin(a)\n",
    "            x = torch.stack([c * x[0] - s * x[1],\n",
    "                             s * x[0] + c * x[1]])\n",
    "            x =torch.roll(x, shifts=(random.randrange(self.L), random.randrange(self.L)),\n",
    "                          dims=(1, 2))           \n",
    "        return x, self.y[i]\n",
