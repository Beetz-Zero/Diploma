    "import torch.optim as optim\n",
    "import numpy as np\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "import sys\n",
    "\n",
    "\n",
    " #МОДЕЛЬ ИЗИНГА \n",
    "\n",
    "class IsingModel:\n",
    "    def __init__(self, X, Y, T=1.0):\n",
    "        self.X = X\n",
    "        self.Y = Y\n",
    "        self.T = T\n",
    "        self.beta = 1.0 / T\n",
    "        self.spins = self.init_model()\n",
    "\n",
    "    def init_model(self):\n",
    "        return np.random.choice([-1, 1], size=(self.X, self.Y))\n",
    "\n",
    "    def calc_hamilt(self):\n",
    "       \n",
    "        energy_right = np.sum(self.spins * np.roll(self.spins, -1, axis=1))\n",
    "        energy_down = np.sum(self.spins * np.roll(self.spins, -1, axis=0))\n",
    "        return -(energy_right + energy_down) / (self.X * self.Y)\n",
    "\n",
    "    def swendsen_wang_step(self, J=1.0):\n",
    "        L = self.spins.shape[0]\n",
    "        p_bond = 1.0 - np.exp(-2.0 * self.beta * J)\n",
    "        \n",
    "        same_h = (self.spins == np.roll(self.spins, -1, axis=1))\n",
    "        bond_h = same_h & (np.random.rand(L, L) < p_bond)\n",
    "        \n",
    "        same_v = (self.spins == np.roll(self.spins, -1, axis=0))\n",
    "        bond_v = same_v & (np.random.rand(L, L) < p_bond)\n",
    "        \n",
    "        labeled_array, num_features = self._find_clusters(bond_h, bond_v)\n",
    "        \n",
    "        for cluster_id in range(1, num_features + 1):\n",
    "            if np.random.rand() < 0.5:\n",
    "                self.spins[labeled_array == cluster_id] *= -1\n",
    "        \n",
    "        return self.spins\n",
    "    \n",
    "    def _find_clusters(self, bond_h, bond_v):\n",
    "        L = self.spins.shape[0]\n",
    "        labels = np.zeros((L, L), dtype=int)\n",
    "        current_label = 0\n",
    "        \n",
    "        for i in range(L):\n",
    "            for j in range(L):\n",
    "                if labels[i, j] == 0:\n",
    "                    current_label += 1\n",
    "                    queue = [(i, j)]\n",
    "                    labels[i, j] = current_label\n",
    "                    \n",
    "                    while queue:\n",
    "                        x, y = queue.pop(0)\n",
    "                        \n",
    "                        neighbors = [\n",
    "                            (x, (y + 1) % L, bond_h[x, y]),\n",
    "                            (x, (y - 1) % L, bond_h[x, (y - 1) % L]),\n",
    "                            ((x + 1) % L, y, bond_v[x, y]),\n",
    "                            ((x - 1) % L, y, bond_v[(x - 1) % L, y])\n",
    "                        ]\n",
    "                        \n",
    "                        for nx, ny, has_bond in neighbors:\n",
    "                            if has_bond and labels[nx, ny] == 0:\n",
    "                                labels[nx, ny] = current_label\n",
    "                                queue.append((nx, ny))\n",
    "        \n",
    "        return labels, current_label\n",
    "    \n",
    "    def simulate(self, n_steps=100):\n",
    "        for _ in range(n_steps):\n",
    "            self.swendsen_wang_step()\n",
    "\n",
    "\n",
    "\n",
