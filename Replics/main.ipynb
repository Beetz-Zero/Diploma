    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "class IsingModel:\n",
    "    def __init__(self, X, Y, T=1.0):\n",
    "        self.X = X\n",
    "        self.Y = Y\n",
    "        self.T = T\n",
    "        self.spins = self.init_model()\n",
    "\n",
    "    def init_model(self):\n",
    "        spins = np.empty((self.X, self.Y))\n",
    "        spins = np.random.randint(low=0, high=2, size=(self.X, self.Y))\n",
    "        for i in range(0, self.X):\n",
    "            for j in range(0, self.Y):\n",
    "                if spins[i][j] == 0 : spins[i,j] = -1 \n",
    "        return spins\n",
    "\n",
    "    def draw_model(self):\n",
    "        plt.axis('off')\n",
    "        plt.imshow(self.spins, cmap='gray')\n",
    "        plt.show()\n",
    "\n",
    "    def calc_magnet(self):\n",
    "        magnetization = 0\n",
    "        for i in range(self.X):\n",
    "            for j in range(self.Y):\n",
    "                magnetization += self.spins[i,j]\n",
    "        return magnetization\n",
    "    \n",
    "    def calc_hamilt(self):\n",
    "        ham = 0\n",
    "        for i in range(self.X):\n",
    "            for j in range(self.Y):\n",
    "                ham += self.spins[i,j]*self.spins[(i+1)%self.X,j] + self.spins[i,j]*self.spins[i,(j+1)%self.Y] + self.spins[i,j]*self.spins[(i-1)%self.X,j] + self.spins[i,j]*self.spins[i,(j-1)%self.Y]\n",
    "        return ham\n",
    "\n",
    "    def swendsen_wang_step(self, spins, beta, J=1.0):\n",
    "        \"\"\"\n",
    "        Один шаг алгоритма Свендсена-Ванга для 2D модели Изинга.\n",
    "        spins: 2D массив (+1 или -1)\n",
    "        beta:  1 / kT\n",
    "        \"\"\"\n",
    "        L = spins.shape[0]\n",
    "        \n",
    "        # 1. Вероятность создания связи между одинаковыми соседями\n",
    "        p_bond = 1.0 - np.exp(-2.0 * beta * J)\n",
    "        \n",
    "        # 2. Генерируем связи по горизонтали и вертикали\n",
    "        # bond_h[i,j] = True, если spins[i,j] == spins[i,j+1] И выпал шанс p_bond\n",
    "        same_h = (spins[:, :-1] == spins[:, 1:])\n",
    "        bond_h = same_h & (np.random.rand(L, L-1) < p_bond)\n",
    "        \n",
    "        same_v = (spins[:-1, :] == spins[1:, :])\n",
    "        bond_v = same_v & (np.random.rand(L-1, L) < p_bond)\n",
    "        \n",
    "        # 3. Находим кластеры (Union-Find через плоский массив)\n",
    "        labels = np.arange(L * L, dtype=np.int32).reshape(L, L)\n",
    "        \n",
    "        def find(x):\n",
    "            while labels.flat[x] != x:\n",
    "                labels.flat[x] = labels.flat[labels.flat[x]]  # path compression\n",
    "                x = labels.flat[x]\n",
    "            return x\n",
    "        \n",
    "        def union(a, b):\n",
    "            ra, rb = find(a), find(b)\n",
    "            if ra != rb:\n",
    "                labels.flat[ra] = rb\n",
    "        \n",
    "        # Объединяем соседей по активным связям\n",
    "        rows, cols = np.where(bond_h)\n",
    "        for r, c in zip(rows, cols):\n",
    "            union(r * L + c, r * L + c + 1)\n",
    "            \n",
    "        rows, cols = np.where(bond_v)\n",
    "        for r, c in zip(rows, cols):\n",
    "            union(r * L + c, (r + 1) * L + c)\n",
    "        \n",
    "        # Приводим все метки к корню кластера\n",
    "        flat_labels = labels.ravel()\n",
    "        for i in range(len(flat_labels)):\n",
    "            flat_labels[i] = find(i)\n",
    "        \n",
    "        # 4. Переворачиваем каждый кластер с вероятностью 0.5\n",
    "        unique_clusters = np.unique(flat_labels)\n",
    "        flip_mask = np.random.rand(len(unique_clusters)) < 0.5\n",
    "        \n",
    "        # Создаём карту: какой кластер переворачивать\n",
    "        cluster_flip = dict(zip(unique_clusters, flip_mask))\n",
    "        flips = np.vectorize(cluster_flip.get)(flat_labels).reshape(L, L)\n",
    "        \n",
    "        spins[flips] *= -1\n",
    "        return spins\n"
   ]
