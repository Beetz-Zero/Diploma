    "def generate_ising_data(temperature_range, grid_size=32, samples_per_temp=50, warmup_steps=200, sample_interval=10):\n",
    "    \"\"\"\n",
    "    Генерирует данные путем запуска симуляции Изинга при разных температурах.\n",
    "    \n",
    "    Args:\n",
    "        temperature_range: список или массив температур\n",
    "        grid_size: размер решетки (grid_size x grid_size)\n",
    "        samples_per_temp: количество образцов для каждой температуры\n",
    "        warmup_steps: количество шагов прогрева системы\n",
    "        sample_interval: интервал между сбором образцов\n",
    "    \n",
    "    Returns:\n",
    "        configurations: массив конфигураций (N, grid_size, grid_size)\n",
    "        energies: массив энергий (N,)\n",
    "        temperatures: массив температур (N,)\n",
    "    \"\"\"\n",
    "    configurations = []\n",
    "    energies = []\n",
    "    temperatures = []\n",
    "    \n",
    "    total_samples = len(temperature_range) * samples_per_temp\n",
    "    print(f\"Генерация {total_samples} образцов для {len(temperature_range)} температур...\")\n",
    "    \n",
    "    for idx, T in enumerate(temperature_range):\n",
    "        print(f\"Температура {T:.2f} ({idx+1}/{len(temperature_range)})\")\n",
    "        \n",
    "        \n",
    "        model = IsingModel(grid_size, grid_size, T=T)\n",
    "        \n",
    "      \n",
    "        model.simulate(warmup_steps)\n",
    "        \n",
    "      \n",
    "        for sample_idx in range(samples_per_temp):\n",
    "            \n",
    "            model.simulate(sample_interval)\n",
    "            \n",
    "          \n",
    "            configurations.append(model.spins.copy())\n",
    "            \n",
    "           \n",
    "            energy = model.calc_hamilt()\n",
    "            energies.append(energy)\n",
    "            \n",
    "           \n",
    "            temperatures.append(T)\n",
    "    \n",
    "    return (np.array(configurations), \n",
    "            np.array(energies), \n",
    "            np.array(temperatures))\n",
    "\n",
